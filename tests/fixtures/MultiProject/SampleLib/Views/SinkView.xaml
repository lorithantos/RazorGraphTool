<Window x:Class="SampleLib.SinkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:SampleLib">

  <!-- Every binding here exists because it reaches its member by a different
       route, or fails to reach one in a different way. A walk that handles one
       shape and not the others produces a partial answer that reads complete. -->
  <StackPanel>

    <!-- Positional path: the ordinary case, one candidate, exact. -->
    <TextBlock Text="{Binding Channel}" />

    <!-- The same member written the other legal way. -->
    <TextBlock Text="{Binding Path=Channel}" />

    <!-- A RelativeSource walk. The leading DataContext is the route taken, not
         the member wanted, and the nested braces carry commas of their own. -->
    <TextBlock Text="{Binding DataContext.Channel, RelativeSource={RelativeSource AncestorType=Window}}" />

    <!-- Dotted: the FIRST segment lives on the DataContext. Write belongs to
         the view model; anything after it belongs to another type entirely. -->
    <TextBlock Text="{Binding Write.Length}" />

    <!-- Reachable only through the code-behind class named by x:Class. -->
    <TextBlock Text="{Binding Caption}" />

    <!-- THE FINDING. Names nothing at all: the shape a rename leaves behind,
         which WPF reports by writing to the debug output and drawing nothing. -->
    <TextBlock Text="{Binding Missing}" />

    <!-- Binds the context object itself and names no member. -->
    <TextBlock Text="{Binding}" />

    <!-- An indexer names no member this layer can resolve. -->
    <TextBlock Text="{Binding Items[0]}" />

    <!-- Not a binding at all. -->
    <TextBlock Text="Channel" />

    <!-- A template that DECLARES what it renders. LedgerSink is an ordinary
         class, not named like a view model, so the name heuristic cannot reach
         its members at all — the declared type is the only thing that can. -->
    <ContentControl>
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="{x:Type lib:LedgerSink}">

          <!-- Resolved against the declared type, exactly. -->
          <TextBlock Text="{Binding Seal}" />

          <!-- THE DEFECT the declared type makes provable. The author said what
               the context is and this member is not on it, so unlike an
               unresolved name with no declared context, this is not a maybe. -->
          <TextBlock Text="{Binding Nonexistent}" />

          <!-- Leaves the template context deliberately, so the declared type is
               the WRONG answer here rather than a better one. LedgerSink also
               declares Write, so scoping this one would resolve it to the wrong
               member and look like a success. -->
          <TextBlock Text="{Binding Write, RelativeSource={RelativeSource AncestorType=Window}}" />

          <!-- A NESTED template establishes its OWN context: the item it
               renders. It declares no DataType, so the context here is UNKNOWN
               rather than the enclosing LedgerSink. Seal exists on LedgerSink
               and on no view model, so scoping this to the outer template would
               resolve it confidently to the wrong member. -->
          <ItemsControl>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Seal}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- A grid COLUMN binds against the row item, not against the context
               the grid sits in, so it resets the context the same way. Scoping
               this to the enclosing LedgerSink would claim LedgerSink has no
               member Rows: a defect report naming a real type, and wrong. -->
          <DataGrid>
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding Rows}" />
            </DataGrid.Columns>
          </DataGrid>

        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!-- A template declaring a type that inherits the member it binds. Origin is
         declared on SinkOrigin, so a lookup that does not walk the base chain
         reports an ordinary binding as a member DerivedSink does not have. -->
    <ContentControl>
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="{x:Type lib:DerivedSink}">
          <TextBlock Text="{Binding Origin}" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

  </StackPanel>
</Window>
