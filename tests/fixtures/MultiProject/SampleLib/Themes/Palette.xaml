<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- No x:Class, so no code-behind. A theme is a view file that declares no
       type, and an absent codeBehind property is a fact about it rather than a
       value the extractor failed to find. -->
  <x:String x:Key="EmptyChannel">none</x:String>

</ResourceDictionary>
