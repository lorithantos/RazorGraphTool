@page "/greeting"
@using SampleApp.Services
@inject IGreetingService Greetings
@inject ILogger<GreetingPanel> Logger

<h2>@message</h2>
<GreetingBadge />

@code {
    private string message = "";

    protected override void OnInitialized()
    {
        message = Greetings.Greet("panel");
        Logger.LogInformation("Greeted");
    }
}
