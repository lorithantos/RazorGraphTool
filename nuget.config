<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- Janet.Mcp.Security is built from Janet.Shared (https://github.com/lorithantos/Janet.Shared)
         and published here rather than to nuget.org for now. Relative, so it survives a clone
         elsewhere as long as the sibling layout holds: C:\repos\RazorGraphTool next to
         C:\repos\.packages. -->
    <add key="local" value="..\.packages" />
  </packageSources>
</configuration>
