<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- MSBuild assemblies must come from the locator-resolved SDK at runtime, never the output dir (MSBL001). -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Must be >= the Roslyn the installed .NET SDK ships (10.0.400 carries 5.9).
         The SDK's source generators are built against its own Roslyn, and
         AnalyzerFileReference.GetGenerators SWALLOWS a load failure — it raises
         AnalyzerLoadFailed and returns an empty list. On 5.6 the Razor generator
         therefore contributed zero generators in silence, so no Razor page class
         ever reached the compilation and the whole generated-class layer went
         missing with no error anywhere. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <!-- Razor parsing uses the last publicly shipped Razor.Language line; the Syntax
         namespace it exposes is internal, unlocked below via Krafs.Publicizer. -->
    <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.Extensions" Version="6.0.36" />
    <PackageReference Include="Microsoft.CodeAnalysis.Razor" Version="6.0.36" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests reach internals directly; nothing else does. A type is not made
         public merely to be testable. -->
    <InternalsVisibleTo Include="RazorGraph.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Microsoft.AspNetCore.Razor.Language" />
    <Publicize Include="Microsoft.AspNetCore.Mvc.Razor.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazorGraph.Core\RazorGraph.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped attribute policy rides inside the assembly, same pattern as
         RazorGraph.Lua's ExternalApis catalogues; a disk override replaces it
         per build without recompiling. -->
    <EmbeddedResource Include="Attributes\*.json" />
  </ItemGroup>

</Project>
