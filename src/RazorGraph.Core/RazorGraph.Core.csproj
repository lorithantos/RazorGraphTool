<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests reach internals directly; nothing else does. A type is not made
         public merely to be testable. -->
    <InternalsVisibleTo Include="RazorGraph.Tests" />
  </ItemGroup>

</Project>