<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebApplication for the HTTP transport, without switching to the Web SDK. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <!--
      The HTTP transport is what removes the publish-and-restart cycle: an HTTP server is a
      separate process the client dials, so it can be killed and rebuilt while a session stays
      open. A stdio server is a child process the client holds open and never reconnects.
    -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <!--
      No Microsoft.Extensions.Hosting package reference: the ASP.NET Core shared framework
      already carries it, and NU1510 correctly calls the duplicate unnecessary.
    -->
    <!-- MSBuild assemblies must come from the locator-resolved SDK at runtime, never the output dir (MSBL001). -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazorGraph.Core\RazorGraph.Core.csproj" />
    <ProjectReference Include="..\RazorGraph.Extractor\RazorGraph.Extractor.csproj" />
    <ProjectReference Include="..\RazorGraph.Lua\RazorGraph.Lua.csproj" />
  </ItemGroup>

</Project>
