<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Global tool">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>razorgraph-mcp</ToolCommandName>
    <PackageId>RazorGraph.Mcp</PackageId>
    <Description>MCP server over a queryable code graph of a .NET solution, built from the compiler's own model. Speaks stdio by default; --http serves one shared server for the development loop. Installing as a global tool puts it on PATH, so client config is a bare command name rather than a machine-specific absolute path.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebApplication for the HTTP transport, without switching to the Web SDK. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <!--
      The HTTP transport is what removes the publish-and-restart cycle: an HTTP server is a
      separate process the client dials, so it can be killed and rebuilt while a session stays
      open. A stdio server is a child process the client holds open and never reconnects.
    -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <!--
      The loopback guard and the bearer check, shared with janet-mcp. From Janet.Shared
      (https://github.com/lorithantos/Janet.Shared), served from the local feed in nuget.config.
    -->
    <PackageReference Include="Janet.Mcp.Security" Version="0.8.0" />
    <!--
      No Microsoft.Extensions.Hosting package reference: the ASP.NET Core shared framework
      already carries it, and NU1510 correctly calls the duplicate unnecessary.
    -->
    <!-- MSBuild assemblies must come from the locator-resolved SDK at runtime, never the output dir (MSBL001). -->
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazorGraph.Core\RazorGraph.Core.csproj" />
    <ProjectReference Include="..\RazorGraph.Extractor\RazorGraph.Extractor.csproj" />
    <ProjectReference Include="..\RazorGraph.Lua\RazorGraph.Lua.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests reach internals directly; nothing else does. A type is not made
         public merely to be testable. -->
    <InternalsVisibleTo Include="RazorGraph.Tests" />
  </ItemGroup>

</Project>