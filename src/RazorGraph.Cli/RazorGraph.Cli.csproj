<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Global tool">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>razorgraph</ToolCommandName>
    <PackageId>RazorGraph.Cli</PackageId>
    <Description>Command line for RazorGraph: builds a queryable code graph of a .NET project or solution from the compiler's own model, saves it as JSON, and queries it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
    <!-- MSBuild assemblies must come from the locator-resolved SDK at runtime, never the output dir (MSBL001). -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazorGraph.Core\RazorGraph.Core.csproj" />
    <ProjectReference Include="..\RazorGraph.Extractor\RazorGraph.Extractor.csproj" />
    <ProjectReference Include="..\RazorGraph.Lua\RazorGraph.Lua.csproj" />
  </ItemGroup>

</Project>
